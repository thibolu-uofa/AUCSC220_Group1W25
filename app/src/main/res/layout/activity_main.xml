<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="@color/black">

    <ImageView
        android:id="@+id/background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/Background"
        android:rotation="45"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="3"
        app:layout_constraintHorizontal_bias="0.507"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.643"
        app:layout_constraintWidth_percent="3"
        app:srcCompat="@drawable/game_background" />

    <ImageView
        android:id="@+id/logo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/Logo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintWidth_percent="0.5"
        app:layout_constraintHeight_percent="0.5"
        app:srcCompat="@drawable/logo"
        app:layout_constraintVertical_bias="0.025"/>

    <com.rollo.TouchColorButton
        android:id="@+id/loadGameButton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintWidth_percent="0.3"
        app:layout_constraintHeight_percent="0.12"
        android:backgroundTint="@color/transparent"
        android:text="@string/LoadGameString"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/golden_white"
        android:fontFamily="@font/catchy_mager"
        android:shadowColor="@color/gold"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="10"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.57" />

    <com.rollo.TouchColorButton
        android:id="@+id/newGameButton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintWidth_percent="0.3"
        app:layout_constraintHeight_percent="0.12"
        android:layout_marginTop="-6dp"
        android:backgroundTint="@color/transparent"
        android:text="@string/NewGameString"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/golden_white"
        android:fontFamily="@font/catchy_mager"
        android:shadowColor="@color/gold"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="10"
        app:layout_constraintTop_toBottomOf="@id/loadGameButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.rollo.TouchColorButton
        android:id="@+id/tutorialButton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintWidth_percent="0.35"
        app:layout_constraintHeight_percent="0.12"
        android:layout_marginTop="-6dp"
        android:backgroundTint="@color/transparent"
        android:text="@string/TutorialString"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/golden_white"
        android:fontFamily="@font/catchy_mager"
        android:shadowColor="@color/gold"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="10"
        app:layout_constraintTop_toBottomOf="@id/newGameButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.rollo.TouchColorButton
        android:id="@+id/creditsButton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintWidth_percent="0.225"
        app:layout_constraintHeight_percent="0.12"
        android:layout_marginTop="-6dp"
        android:backgroundTint="@color/transparent"
        android:text="@string/CreditsString"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/golden_white"
        android:fontFamily="@font/catchy_mager"
        android:shadowColor="@color/gold"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="10"
        app:layout_constraintTop_toBottomOf="@id/tutorialButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/inspirationText"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintWidth_percent="0.4"
        app:layout_constraintHeight_percent="0.05"
        android:backgroundTint="#00000000"
        android:text="@string/InspirationString"
        android:textAlignment="center"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/golden_white"
        android:fontFamily="@font/catchy_mager"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.985" />

    <TextView
        android:id="@+id/appVerText"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintWidth_percent="0.2"
        app:layout_constraintHeight_percent="0.1"
        android:backgroundTint="#00000000"
        android:text="@string/AppVerString"
        android:textAlignment="textEnd"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/golden_white"
        android:fontFamily="@font/catchy_mager"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintVertical_bias="0.995" />

    <View
        android:id="@+id/dimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone" />

    <View
        android:id="@+id/creditsView"
        android:visibility="gone"
        android:layout_width="500dp"
        android:layout_height="300dp"
        android:background="@drawable/credits"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintVertical_bias="0.5"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.rollo.TouchColorButton
        android:id="@+id/creditsBackButton"
        android:visibility="gone"
        android:layout_width="465dp"
        android:layout_height="40dp"
        android:backgroundTint="#00000000"
        app:layout_constraintVertical_bias="0.975"
        app:layout_constraintTop_toTopOf="@id/creditsView"
        app:layout_constraintBottom_toBottomOf="@id/creditsView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.rollo.TouchColorButton
        android:id="@+id/tutorialBackButton"
        android:visibility="gone"
        android:layout_width="465dp"
        android:layout_height="40dp"
        android:backgroundTint="#00000000"
        app:layout_constraintVertical_bias="0.975"
        app:layout_constraintTop_toTopOf="@id/tutorialView"
        app:layout_constraintBottom_toBottomOf="@id/tutorialView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/tutorialView"
        android:visibility="gone"
        android:layout_width="500dp"
        android:layout_height="300dp"
        android:background="@drawable/tutorial"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintVertical_bias="0.5"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/blackoutView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="10dp"
        android:background="@color/black" />

    <!-- <ImageView
        android:id="@+id/diceView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/dice_1" /> -->
</androidx.constraintlayout.widget.ConstraintLayout>
