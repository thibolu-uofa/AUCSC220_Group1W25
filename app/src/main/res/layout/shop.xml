<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FCF5FD"
    android:backgroundTint="#B99903"
    android:screenOrientation="landscape"
    tools:context=".ShopPage">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="2082dp"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:scaleType="centerCrop"
        app:srcCompat="@drawable/background" />

    <TextView
        android:id="@+id/BoxBehindUpgrades"
        android:layout_width="434dp"
        android:layout_height="218dp"
        android:layout_marginStart="47dp"
        android:layout_marginTop="152dp"
        android:layout_marginEnd="47dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/box"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/PaintingBox"
        android:layout_width="270dp"
        android:layout_height="122dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/box"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.028" />


    <ImageView
        android:id="@+id/imageView8"
        android:layout_width="268dp"
        android:layout_height="47dp"
        android:layout_marginStart="165dp"
        android:layout_marginTop="152dp"
        android:layout_marginEnd="165dp"
        android:layout_marginBottom="122dp"
        android:clickable="true"
        android:focusable="true"
        android:onClick="onCombosClick"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.488"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.333"
        app:srcCompat="@drawable/combos_button" />

    <ImageView
        android:id="@+id/imageView9"
        android:layout_width="268dp"
        android:layout_height="76dp"
        android:layout_marginTop="228dp"
        android:clickable="true"
        android:focusable="true"
        android:onClick="onPaintingClick"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/painting_s_button" />

    <ImageView
        android:id="@+id/imageView10"
        android:layout_width="267dp"
        android:layout_height="76dp"
        android:layout_marginTop="304dp"
        android:clickable="true"
        android:focusable="true"
        android:onClick="onVouchersClick"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.495"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vouchers_button" />

    <TextView
        android:id="@+id/painting2"
        android:layout_width="48dp"
        android:layout_height="95dp"
        android:background="@drawable/dashed_line"
        android:onClick="selectedPainting"
        app:layout_constraintBottom_toBottomOf="@+id/PaintingBox"
        app:layout_constraintEnd_toEndOf="@+id/PaintingBox"
        app:layout_constraintHorizontal_bias="0.346"
        app:layout_constraintStart_toStartOf="@+id/PaintingBox"
        app:layout_constraintTop_toTopOf="@+id/PaintingBox"
        app:layout_constraintVertical_bias="0.481" />

    <TextView
        android:id="@+id/painting3"
        android:layout_width="48dp"
        android:layout_height="95dp"
        android:background="@drawable/dashed_line"
        android:onClick="selectedPainting"
        app:layout_constraintBottom_toBottomOf="@+id/PaintingBox"
        app:layout_constraintEnd_toEndOf="@+id/PaintingBox"
        app:layout_constraintHorizontal_bias="0.635"
        app:layout_constraintStart_toStartOf="@+id/PaintingBox"
        app:layout_constraintTop_toTopOf="@+id/PaintingBox"
        app:layout_constraintVertical_bias="0.481" />

    <TextView
        android:id="@+id/painting4"
        android:layout_width="48dp"
        android:layout_height="95dp"
        android:background="@drawable/dashed_line"
        android:onClick="selectedPainting"
        app:layout_constraintBottom_toBottomOf="@+id/PaintingBox"
        app:layout_constraintEnd_toEndOf="@+id/PaintingBox"
        app:layout_constraintHorizontal_bias="0.936"
        app:layout_constraintStart_toStartOf="@+id/PaintingBox"
        app:layout_constraintTop_toTopOf="@+id/PaintingBox"
        app:layout_constraintVertical_bias="0.481" />

    <TextView
        android:id="@+id/painting1"
        android:layout_width="48dp"
        android:layout_height="95dp"
        android:background="@drawable/dashed_line"
        android:onClick="selectedPainting"
        app:layout_constraintBottom_toBottomOf="@+id/PaintingBox"
        app:layout_constraintEnd_toEndOf="@+id/PaintingBox"
        app:layout_constraintHorizontal_bias="0.063"
        app:layout_constraintStart_toStartOf="@+id/PaintingBox"
        app:layout_constraintTop_toTopOf="@+id/PaintingBox"
        app:layout_constraintVertical_bias="0.481" />


</androidx.constraintlayout.widget.ConstraintLayout>