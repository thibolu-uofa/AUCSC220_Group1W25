<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/dice_frame"/>
    <item
        android:width="7dp"
        android:height="7dp"
        android:top="10dp"
        android:left="10dp">
        <shape android:shape="oval">
            <solid android:color="@color/black" />
        </shape>
    </item>

    <item
        android:width="7dp"
        android:height="7dp"
        android:gravity="bottom|right"
        android:right="10dp"
        android:bottom="10dp">
        <shape android:shape="oval">
            <solid android:color="@color/black" />
        </shape>
    </item>
</layer-list>
